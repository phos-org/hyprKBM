#!/usr/bin/env python3
"""hyprKBM: a keyboard-first keybind manager for Hyprland's Lua config.

  hyprkbm                      open the keyboard panel
  hyprkbm --export md [FILE]   write a Markdown cheatsheet (stdout without FILE)
  hyprkbm --apply [FILE]       apply keybinds.json, or FILE, to Hyprland
  hyprkbm --status             binds, conflicts, stale edits and the watcher
  hyprkbm --binds              hand-written binds: keys, submap, where, fingerprint
  hyprkbm --state              everything the panel shows, as JSON
  hyprkbm --backup NAME        one backup's keybinds.json and keybinds.lua, as JSON
  hyprkbm --set-layout NAME    the panel's keyboard layout: ansi or iso
"""
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from hyprkbm.apply import apply  # noqa: E402
from hyprkbm.catalogue import load_catalogue  # noqa: E402
from hyprkbm.export import export_markdown  # noqa: E402
from hyprkbm.model import ModelError, load_model, merge, structure_errors  # noqa: E402
from hyprkbm.paths import Paths  # noqa: E402
from hyprkbm.reader import read_config  # noqa: E402
from hyprkbm.state import SettingsError, build_state, read_backup, set_layout  # noqa: E402

UNIT = "hyprkbm-watch.service"
ROOT = Path(os.path.realpath(__file__)).parents[1]
PANEL = ROOT / "quickshell" / "hyprkbm"
PANEL_CLASS = "org.quickshell"
TITLE = "Keybinds"


def fail(*messages, code=1):
    for m in messages:
        print("hyprkbm: %s" % m, file=sys.stderr)
    return code


def load_state(paths):
    """Hand binds, the model and the catalogue, or a list of reasons not."""
    try:
        hand = read_config(paths)
    except OSError as exc:  # no Lua interpreter to run the reader with
        return None, ["the config could not be read: %s" % exc]
    if hand.error:
        print("hyprkbm: warning: %s: %s" % (paths.entry, hand.error), file=sys.stderr)
    try:
        model = load_model(paths.model)
    except ModelError as exc:
        return None, [str(exc)]
    catalogue = load_catalogue()
    errors = structure_errors(model, hand, catalogue)
    if errors:
        return None, ["%s: %s" % (paths.model, e["message"]) for e in errors]
    return (hand, model, catalogue), []


def cmd_export(paths, args):
    if not args or args[0] != "md" or len(args) > 2:
        return fail("usage: hyprkbm --export md [FILE]", code=2)
    state, errors = load_state(paths)
    if errors:
        return fail(*errors)
    hand, model, catalogue = state
    text = export_markdown(merge(model, hand, catalogue), catalogue)
    if len(args) == 2:
        try:
            Path(args[1]).write_text(text, encoding="utf-8")
        except OSError as exc:
            return fail("%s could not be written: %s" % (args[1], exc))
    else:
        sys.stdout.write(text)
    return 0


def cmd_apply(paths, args):
    if len(args) > 1:
        return fail("usage: hyprkbm --apply [FILE]", code=2)
    try:
        model = load_model(Path(args[0]) if args else paths.model)
    except ModelError as exc:
        return fail(str(exc))
    try:
        result = apply(model, paths)
    except Exception as exc:  # apply() restores the old files before re-raising
        return fail("apply failed: %s" % exc)
    if not result["ok"]:
        return fail(*(e["message"] for e in result["errors"]))
    print("Applied." + (" Previous keybinds saved in %s." % result["backup"]
                        if result["backup"] else ""))
    return 0


def cmd_binds(paths):
    """Every hand-written bind with what an override or unbind needs to name
    it -- keys, submap, fingerprint -- until the panel writes those itself."""
    try:
        hand = read_config(paths)
    except OSError as exc:  # no Lua interpreter to run the reader with
        return fail("the config could not be read: %s" % exc)
    if hand.error:
        print("hyprkbm: warning: %s: %s" % (paths.entry, hand.error), file=sys.stderr)
    for b in hand.binds:
        print("\t".join((b.keys, b.submap, b.where, b.fingerprint)))
    return 0


def cmd_status(paths):
    state, errors = load_state(paths)
    if errors:
        return fail(*errors)
    hand, model, catalogue = state
    merged = merge(model, hand, catalogue)
    print("config: %s%s" % (paths.entry, " (could not be read completely)" if hand.error else ""))
    print("hand-written binds: %d" % len(hand.binds))
    print("hyprKBM binds: %d (%d overrides), %d unbinds" % (
        len(model.get("binds", [])),
        sum(1 for b in merged.binds if b.source == "override"),
        len(model.get("unbinds", []))))
    conflicts = merged.conflicts()
    print("conflicts: %d" % len(conflicts))
    for group in conflicts:
        print("  %s: %s" % (group[0].keys, ", ".join(b.where for b in group)))
    print("stale: %d" % len(merged.stale))
    for s in merged.stale:
        print("  %s: %s" % (s["keys"], s["message"]))
    try:
        res = subprocess.run(["systemctl", "--user", "is-active", UNIT],
                             capture_output=True, text=True, timeout=5)
        watcher = res.stdout.strip() or "unknown"
    except OSError:
        watcher = "unknown (no systemctl)"
    except subprocess.TimeoutExpired:
        watcher = "unknown"
    print("watcher: %s" % watcher)
    return 0


def cmd_state(paths):
    print(json.dumps(build_state(paths), ensure_ascii=False))
    return 0


def cmd_backup(paths, args):
    if len(args) != 1:
        return fail("usage: hyprkbm --backup NAME", code=2)
    found = read_backup(paths, args[0])
    if found is None:
        return fail("no backup called %s" % args[0])
    print(json.dumps(found, ensure_ascii=False))
    return 0


def cmd_set_layout(paths, args):
    if len(args) != 1:
        return fail("usage: hyprkbm --set-layout ansi|iso", code=2)
    try:
        set_layout(paths, args[0])
    except SettingsError as exc:
        return fail(str(exc), code=1)
    except ValueError as exc:
        return fail(str(exc), code=2)
    except OSError as exc:
        return fail("settings could not be written: %s" % exc)
    return 0


def panel_open():
    """Whether the panel already has a window: class as well as title, so a
    terminal that happens to be called Keybinds is not mistaken for it."""
    try:
        res = subprocess.run(["hyprctl", "-j", "clients"], capture_output=True, text=True, timeout=5)
        clients = json.loads(res.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return False
    return isinstance(clients, list) and any(
        isinstance(c, dict) and c.get("class") == PANEL_CLASS and c.get("title") == TITLE
        for c in clients)


# Tiled, the panel gets whatever share of the workspace is left, often far
# below the size it is laid out for. This rule makes it float, centred, at its
# own size. It is added at run time, like the binds, so hyprland.lua is never
# touched; a reload drops it together with the global that stops repeated
# launches from adding it again.
FLOAT_RULE = """\
if not __hyprkbm_panel_rule then
    __hyprkbm_panel_rule = hl.window_rule({
        name = "hyprkbm-panel",
        match = { class = "^org[.]quickshell$", title = "^Keybinds$" },
        float = true,
        center = true,
        size = "1180 760",
    })
end
"""


def float_the_panel():
    try:
        subprocess.run(["hyprctl", "eval", FLOAT_RULE], capture_output=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass  # a tiled panel still works; it is just cramped


def cmd_panel(paths):
    if shutil.which("qs") is None:
        return fail("Quickshell (qs) is not installed; the panel needs it. "
                    "The command line works without it: see hyprkbm --help")
    if panel_open():
        try:
            subprocess.run(["hyprctl", "dispatch", "focuswindow", "title:^%s$" % TITLE],
                           capture_output=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            pass  # the panel is open; failing to raise it is not worth an error
        return 0
    # A keybind's PATH does not include ~/.local/bin, so the panel is told
    # where its helpers are rather than left to find them.
    env = dict(os.environ, HYPRKBM_BIN=str(ROOT / "bin"))
    float_the_panel()
    # -n: a second launch before the first window is listed must not open a second panel.
    subprocess.Popen(["qs", "-p", str(PANEL), "-d", "-n"], env=env,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    return 0


def main(argv):
    paths = Paths.from_env()
    if argv[:1] == ["--export"]:
        return cmd_export(paths, argv[1:])
    if argv[:1] == ["--apply"]:
        return cmd_apply(paths, argv[1:])
    if argv == ["--status"]:
        return cmd_status(paths)
    if argv == ["--binds"]:
        return cmd_binds(paths)
    if argv == ["--state"]:
        return cmd_state(paths)
    if argv[:1] == ["--backup"]:
        return cmd_backup(paths, argv[1:])
    if argv[:1] == ["--set-layout"]:
        return cmd_set_layout(paths, argv[1:])
    if argv in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if argv == []:
        return cmd_panel(paths)
    if argv == ["--cheatsheet"]:
        return fail("the cheatsheet overlay is not in this version yet; "
                    "hyprkbm --export md writes a cheatsheet as Markdown", code=2)
    return fail(__doc__.strip(), code=2)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
