#!/usr/bin/env python3
"""Keep hyprKBM's keybinds applied to Hyprland.

hyprKBM applies keybinds.lua to the running compositor with `hyprctl eval`,
so hyprland.lua needs no line loading it -- but a reload re-runs hyprland.lua
and drops everything eval set, and a new login starts from hyprland.lua alone.
This listens on Hyprland's event socket and answers every `configreloaded`
with `hyprkbm-apply --live`, and applies once when it starts, which the
systemd user unit makes happen at login.

hyprkbm-apply reloads Hyprland itself before applying; it leaves a marker so
the reload it caused is not answered twice.
"""
import errno
import fcntl
import os
import socket
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from hyprkbm import marker  # noqa: E402
from hyprkbm.paths import Paths  # noqa: E402
from hyprkbm.state import ensure_config  # noqa: E402

RELOADED = "configreloaded"
CAPTURE_SUBMAP = "hyprkbm-capture"
# Find mode (the panel's F) switches Hyprland into this submap, which turns
# the user's binds off. The panel leaves it itself; this is the backstop for a
# panel that died mid-find. The Lua is Capture.leaveLua() in
# quickshell/hyprkbm/lib/capture.js and must stay identical to it.
LEAVE_CAPTURE_LUA = 'if hl.get_current_submap() == "hyprkbm-capture" then hl.dispatch(hl.dsp.submap("reset")) end'
PANEL_CLASS = "org.quickshell"
PANEL_TITLE = "Keybinds"
RECONNECT_SECONDS = 2.0
SELF_DIR = os.path.dirname(os.path.realpath(__file__))


def claim_single_instance(paths):
    """Two watchers would both answer every reload. The handle is never
    closed: the lock lasts as long as this process does."""
    paths.runtime_dir.mkdir(parents=True, exist_ok=True)
    handle = open(paths.lock, "a", encoding="utf-8")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as exc:
        if exc.errno in (errno.EACCES, errno.EAGAIN):
            # Status 0: the job is being done, and a failure here would have
            # systemd restart this one in a loop.
            print("another hyprkbm-watch already holds %s" % paths.lock, file=sys.stderr)
            sys.exit(0)
        raise
    return handle


def apply_command():
    sibling = os.path.join(SELF_DIR, "hyprkbm-apply")
    if os.access(sibling, os.X_OK):
        return sibling
    from shutil import which
    found = which("hyprkbm-apply")
    if not found:
        sys.exit("hyprkbm-apply not found next to %s or on PATH" % SELF_DIR)
    return found


def socket_path():
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not signature:
        sys.exit("HYPRLAND_INSTANCE_SIGNATURE unset -- not inside a Hyprland session")
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    return os.path.join(runtime, "hypr", signature, ".socket2.sock")


def run_live(command):
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    try:
        res = subprocess.run([command, "--live"], capture_output=True, text=True)
    except Exception as exc:
        # A failed apply must not end event processing.
        print("%s apply --live failed to run: %s" % (stamp, exc), file=sys.stderr, flush=True)
        return
    print("%s apply --live rc=%d %s" % (stamp, res.returncode,
                                        (res.stdout + res.stderr).strip()), flush=True)


def consume_marker(paths, now=None):
    """True when the reload was hyprkbm-apply's own, which applies the binds
    itself. The marker is a count, kept by hyprkbm.marker, because an apply
    that rolls back reloads twice."""
    return marker.consume(paths, now)


def should_leave_capture(submap, active_class, active_title):
    """Capture mode with any window but the panel focused means the panel is
    gone (or lost focus), and nothing else will end it before the timeout."""
    return (submap == CAPTURE_SUBMAP
            and not (active_class == PANEL_CLASS and active_title == PANEL_TITLE))


def leave_capture():
    try:
        # Bounded: a hung hyprctl must not stall event processing.
        res = subprocess.run(["hyprctl", "eval", LEAVE_CAPTURE_LUA],
                             capture_output=True, text=True, timeout=5)
        if res.returncode != 0:
            print("leaving the capture submap failed rc=%d %s" % (
                res.returncode, (res.stdout + res.stderr).strip()), file=sys.stderr, flush=True)
    except (subprocess.TimeoutExpired, OSError) as exc:
        print("leaving the capture submap failed: %s" % exc, file=sys.stderr, flush=True)


def read_events(sock, on_reload, on_stray_capture=None):
    buffer = b""
    submap = ""
    # Unknown until the first activewindow event: judging capture against a
    # guessed window would reset it the instant it begins.
    active = None
    while True:
        chunk = sock.recv(4096)
        if not chunk:
            return
        buffer += chunk
        *lines, buffer = buffer.split(b"\n")
        for line in lines:
            name, _, data = line.decode("utf-8", "replace").partition(">>")
            if name == RELOADED:
                on_reload()
            elif name == "submap":
                submap = data
            elif name == "activewindow":
                # The title may itself hold commas; the class cannot.
                cls, _, title = data.partition(",")
                active = (cls, title)
            else:
                continue
            if (on_stray_capture and active is not None
                    and should_leave_capture(submap, *active)):
                on_stray_capture()


def serve(sock, command, paths):
    """One connection's work. At login, and after any gap in the connection,
    hyprland.lua may have run without hyprKBM's binds, so apply first."""
    run_live(command)

    def on_reload():
        if consume_marker(paths):
            print("reload made by hyprkbm-apply; it applied the binds itself", flush=True)
        else:
            run_live(command)

    read_events(sock, on_reload, leave_capture)


def main():
    paths = Paths.from_env()
    ensure_config(paths)
    _lock = claim_single_instance(paths)
    command = apply_command()
    path = socket_path()

    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.connect(path)
                print("watching %s" % path, flush=True)
                serve(sock, command, paths)
        except OSError as exc:
            print("socket error: %s" % exc, file=sys.stderr, flush=True)
        time.sleep(RECONNECT_SECONDS)


if __name__ == "__main__":
    main()
